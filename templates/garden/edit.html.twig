{% extends 'base.html.twig' %}

{% block title %}Edit the garden info of {{ planting.name }} · Hop Garden{% endblock %}

{% block body %}
    <header class="plate-head">
        <nav class="breadcrumb"><a href="{{ path('garden') }}">Garden</a> / <a href="{{ path('garden_show', {id: planting.id}) }}">{{ planting.name }}</a> / Edit garden info</nav>
        <h1>Edit the garden info of {{ planting.name }}</h1>
        <p>
            Where and how it grows in your garden.
            {%- if planting.scientificName %} Its species stays <em>{{ planting.scientificName }}</em>, with its care sheet.{% endif %}
        </p>
    </header>

    {{ form_start(form, {attr: {class: 'card crowned care-sheet-form garden-form'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.name) }}
        {{ include('garden/_form.html.twig', planting.photoFilename ? {photo_help: 'JPEG, PNG or WebP, up to 10 MB. A new photo replaces the current one.'} : {}) }}

        <div class="actions">
            <twig:Button href="{{ path('garden_show', {id: planting.id}) }}" class="button-secondary">Cancel</twig:Button>
            <twig:Button icon="check" :iconSize="18">Save</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
