{% extends 'base.html.twig' %}

{% block title %}{{ 'planting.edit.title'|trans({name: planting.name}) }} · Hop Garden{% endblock %}

{% block body %}
    <header class="plate-head">
        <nav class="breadcrumb"><span class="page-label page-label-plant">{{ 'planting.label'|trans }}</span> <a href="{{ path('garden') }}">{{ 'nav.garden'|trans }}</a> › <a href="{{ path('garden_show', {planting: planting.slug}) }}">{{ planting.name }}</a> › {{ 'planting.edit.breadcrumb'|trans }}</nav>
        <h1>{{ 'planting.edit.title'|trans({name: planting.name}) }}</h1>
        <p>
            {{ 'planting.edit.intro'|trans }}
            {%- if planting.scientificName %} {{ 'planting.edit.species_stays'|trans({species: '<em>' ~ planting.scientificName|e ~ '</em>'})|raw }}{% endif %}
        </p>
    </header>

    {{ form_start(form, {attr: {class: 'card crowned care-sheet-form garden-form'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.name) }}
        {{ include('garden/_form.html.twig', planting.photoFilename ? {photo_help: 'planting.form.photo.help_replace'|trans} : {}) }}

        <div class="actions">
            <twig:Button href="{{ path('garden_show', {planting: planting.slug}) }}" class="button-secondary">{{ 'action.cancel'|trans }}</twig:Button>
            <twig:Button icon="check" :iconSize="18">{{ 'action.save'|trans }}</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
