{% extends 'base.html.twig' %}

{% block title %}{{ 'planting.new.title'|trans }} · Hop Garden{% endblock %}

{% block body %}
    <header class="plate-head">
        {% if plant %}
            <nav class="breadcrumb"><span class="page-label page-label-species">{{ 'species.label'|trans }}</span> <a href="{{ path('plant_index') }}">{{ 'species.all'|trans }}</a> › <a href="{{ path('plant_show', {plant: plant.slug}) }}"><em>{{ plant.scientificName }}</em></a> › {{ 'action.add_to_my_garden'|trans }}</nav>
            <h1>{{ 'planting.new.title_of_species'|trans({species: '<em>' ~ plant.scientificName|e ~ '</em>'})|raw }}</h1>
            <p>{{ 'planting.new.intro_of_species'|trans({name: plant.commonName}) }}</p>
        {% else %}
            <nav class="breadcrumb"><span class="page-label page-label-plant">{{ 'planting.label'|trans }}</span> <a href="{{ path('garden') }}">{{ 'nav.garden'|trans }}</a> › {{ 'planting.new.breadcrumb'|trans }}</nav>
            <h1>{{ 'planting.new.title'|trans }}</h1>
            <p>{{ 'planting.new.intro'|trans }}</p>
        {% endif %}
    </header>

    {{ form_start(form, {attr: {class: 'card crowned care-sheet-form garden-form'}}) }}
        {{ form_errors(form) }}

        {% if plant %}
            {# Picked on the page of the species: it stays #}
            <div class="garden-species">
                {{ form_row(form.name) }}
                <p class="garden-species-chosen"><span class="kicker">{{ 'species.label'|trans }}</span> <em>{{ plant.scientificName }}</em> <span class="hint">{{ plant.commonName }}</span></p>
            </div>
        {% else %}
            <twig:SpeciesPicker :form="form"/>
        {% endif %}

        {{ include('garden/_form.html.twig') }}

        <div class="actions">
            <twig:Button href="{{ plant ? path('plant_show', {plant: plant.slug}) : path('garden') }}" class="button-secondary">{{ 'action.cancel'|trans }}</twig:Button>
            <twig:Button icon="sprout" :iconSize="18">{{ 'action.add_to_my_garden'|trans }}</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
