{% extends 'base.html.twig' %}

{% block title %}{{ planting.name }} · Hop Garden{% endblock %}

{# Once the care sheet is drafted, the worker updates the page in place, or refreshes it after a failure (a morph): see
   App\Garden\DraftCareSheetHandler #}
{% block head %}{{ turbo_refreshes_with('morph', 'preserve') }}{{ turbo_exempts_page_from_cache() }}{% endblock %}

{% block body %}
    {% set plant = planting.plant %}
    {% set photo_url = planting_photo_url(planting) %}
    <nav class="breadcrumb"><span class="page-label page-label-plant">{{ 'planting.label'|trans }}</span> <a href="{{ path('garden') }}">{{ 'nav.garden'|trans }}</a> › {{ planting.name }}</nav>

    {# Until its care sheet is validated: the agent drafting it, then the summary of its draft, or a retry #}
    <div {% if recommendations is null -%}
        data-controller="drafting"
        data-drafting-drafting-value="{{ planting.drafting ? 'true' : 'false' }}"
        data-drafting-status-url-value="{{ path('garden_drafting', {planting: planting.slug}) }}"
        data-drafting-silence-value="{{ 'chat.silence'|trans }}"
        data-action="turbo:before-stream-render@document->drafting#watch"
    {%- endif %}>
    {# The tool calls of the agent as they come, then the draft, or a refresh: see App\Garden\DraftCareSheetHandler #}
    {% if topic %}{{ turbo_stream_from(topic, private: true) }}{% endif %}
    <div class="planting-layout">
        <article class="card crowned planting-card">
            {% if photo_url %}
                <figure class="garden-photo"><img src="{{ photo_url }}" alt="{{ planting.name }}"></figure>
            {% endif %}
            <header class="card-head">
                {% if not photo_url %}
                    <span class="plant-card-image"><twig:PlantingPhoto :planting="planting" :size="45"/></span>
                {% endif %}
                <div>
                    <p class="kicker">{{ 'specimen.number'|trans({number: planting.id|specimen_number}) }}</p>
                    <h3>{{ planting.name }}</h3>
                    {# The Latin name is the species: in its summary once it has a care sheet #}
                    {% if not plant and planting.scientificName %}<p class="latin" id="planting-{{ planting.id }}-chosen-species"><span class="page-label page-label-species">{{ 'species.label'|trans }}</span> <em>{{ planting.scientificName }}</em></p>{% endif %}
                </div>
                {% if plant and plant.validated %}
                    <twig:Status :validated="true"/>
                {% else %}
                    <twig:Status>{{ 'status.care_sheet_in_progress'|trans }}</twig:Status>
                {% endif %}
            </header>

            {# Where it grows: its space, with its exposure, its soil and its neighbours #}
            <table class="care-sheet planting-place">
                <tbody>
                    <twig:Planting:Space :planting="planting"/>
                </tbody>
            </table>

            {# How it is doing, and the care it got #}
            <table class="care-sheet planting-care">
                <tbody>
                    <tr>
                        <th scope="row"><span class="pict"><twig:Icon name="bee" :size="17"/></span> {{ 'planting.diseases'|trans }}</th>
                        <td>{{ planting.diseases ?? 'planting.none_recorded'|trans }}</td>
                    </tr>
                    <tr>
                        <th scope="row"><span class="pict"><twig:Icon name="secateurs" :size="17"/></span> {{ 'planting.care_done'|trans }}</th>
                        <td>
                            {% for record in planting.careRecords|reverse %}
                                {{- 'planting.care_record'|trans({task: record.task|trans, date: record.doneOn|long_date}) }}{{ not loop.last ? ', ' -}}
                            {% else %}
                                {{ 'planting.none_recorded'|trans }}
                            {% endfor %}
                        </td>
                    </tr>
                </tbody>
            </table>

            <footer class="card-foot">
                <p>{{ 'planting.since'|trans({date: planting.createdAt|long_date}) }}</p>
                <div class="actions">
                    <twig:Button href="{{ path('garden_edit', {planting: planting.slug}) }}" icon="pencil" class="button-secondary">{{ 'planting.edit.breadcrumb'|trans }}</twig:Button>
                </div>
            </footer>
        </article>

        <div class="planting-aside">
        <section class="card recommendations" id="recommendations">
            <h2>{{ 'recommendation.title'|trans }}</h2>
            {% if recommendations is not null %}
                <ul class="recommendation-list">
                    {% for recommendation in recommendations %}
                        <twig:Recommendation :recommendation="recommendation"/>
                    {% endfor %}
                </ul>
                <p class="hint garden-source">{{ 'recommendation.source'|trans({species: '<a href="' ~ path('plant_show', {plant: plant.slug}) ~ '">' ~ plant.commonName|e ~ '</a>'})|raw }}</p>
            {% else %}
                <div id="planting-{{ planting.id }}-draft-status"><twig:Garden:DraftStatus :planting="planting"/></div>
                <div class="garden-tool-calls" id="drafting-tool-calls">
                    {%- for summary in tool_calls %}
                        <twig:Chat:ToolCall :summary="summary"/>
                    {%- endfor -%}
                </div>
                <div class="garden-failure" data-drafting-target="failure" {{ plant or planting.drafting ? 'hidden' }}>
                    <p class="warning" data-drafting-target="failureMessage">
                        {{- (planting.hasDraftingFailed() ? 'planting.drafting_failed' : 'planting.no_care_sheet')|trans -}}
                    </p>
                    <form method="post" action="{{ path('garden_draft', {planting: planting.slug}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('planting') }}">
                        <twig:Button icon="sprout" :iconSize="18">{{ 'action.retry'|trans }}</twig:Button>
                    </form>
                </div>
                {% if same_species_plants is not empty %}
                    <div id="planting-{{ planting.id }}-same-species">
                    <p class="hint">{{ 'planting.same_species'|trans({species: '<em>' ~ planting.scientificName|e ~ '</em>'})|raw }}</p>
                    <div class="actions">
                        {% for same_species_plant in same_species_plants %}
                            <form method="post" action="{{ path('garden_link_plant', {planting: planting.slug}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('planting') }}">
                                <input type="hidden" name="plant" value="{{ same_species_plant.id }}">
                                <twig:Button class="button-secondary">{{ 'planting.use_the_sheet_of'|trans({name: same_species_plant.commonName}) }}</twig:Button>
                            </form>
                        {% endfor %}
                    </div>
                    </div>
                {% endif %}
            {% endif %}
        </section>

        <div id="planting-{{ planting.id }}-species">{% if plant %}<twig:SpeciesSummary :plant="plant"/>{% endif %}</div>
        </div>
    </div>
    </div>
{% endblock %}
