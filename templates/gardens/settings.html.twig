{% extends 'base.html.twig' %}

{% block title %}{{ 'garden.settings.title'|trans }} · Hop Garden{% endblock %}

{# By its owner only (GARDEN_MANAGE): its name, and its place, kept unless a city is searched. Its members: their page #}
{% block body %}
    <header class="plate-head">
        <span class="plate-tab">{{ 'garden.settings.tab'|trans }}</span>
        <h1>{{ garden.name }}</h1>
        <p>{{ 'garden.settings.intro'|trans({place: garden.location.placeName, timezone: garden.location.timezone.name}) }}</p>
    </header>

    {{ include('gardens/_form.html.twig', {submit: 'action.save'|trans}) }}

    <p class="callout garden-settings-members">
        <a href="{{ path('garden_members', {id: garden.id}) }}">{{ 'garden.settings.members'|trans({count: garden.memberships|length}) }}</a>
    </p>
{% endblock %}
