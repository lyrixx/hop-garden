{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.notifications'|trans }} · Hop Garden{% endblock %}

{% block body %}
<div class="with-specimen">
<div>
    <twig:PlateHead tab="V" :title="'nav.notifications'|trans" :subtitle="'notification.subtitle'|trans"/>

    {# What the agent gets from upcoming_reminders and get_frost_forecast #}
    <div class="reminder-board">
        <section class="card reminder-section coming-up" aria-labelledby="coming-up-title">
            <h2 id="coming-up-title"><span class="pict"><twig:Icon name="bell" :size="18"/></span> {{ 'notification.coming_up.title'|trans }}</h2>
            <p class="hint">{{ 'notification.coming_up.hint'|trans({weeks: coming_up_days // 7}) }}</p>
            {% if coming_up is empty %}
                <p class="reminder-empty">{{ 'notification.coming_up.empty'|trans }}</p>
            {% else %}
                <ul class="upcoming-list">
                    {% for upcoming in coming_up %}
                        <twig:Reminder:Upcoming :upcoming="upcoming" :plantingIds="planting_ids"/>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if forecast_days is null %}
                <p class="hint">{{ 'notification.coming_up.no_forecast'|trans }}</p>
            {% endif %}
        </section>

        <section class="card reminder-section frost-forecast" aria-labelledby="frost-forecast-title">
            <h2 id="frost-forecast-title"><span class="pict pict-frost"><twig:Icon name="snowflake" :size="18"/></span> {{ 'forecast.title'|trans }}</h2>
            {% if forecast_days is null %}
                <p class="warning forecast-unavailable">{{ 'forecast.unavailable'|trans }}</p>
            {% else %}
                <p class="hint">{{ 'forecast.hint'|trans }}</p>
                <ul class="forecast-list">
                    {% for day in forecast_days %}
                        <twig:Reminder:ForecastDay :day="day" :plantingIds="planting_ids"/>
                    {% endfor %}
                </ul>
                <p class="meta">{{ 'forecast.credit'|trans({open_meteo: '<a href="https://open-meteo.com/">Open-Meteo.com</a>'})|raw }}</p>
            {% endif %}
        </section>
    </div>

    <h2 class="received-title">{{ 'notification.received.title'|trans }}</h2>
    {% if notifications is empty %}
        <p class="callout">{{ 'notification.received.empty'|trans }}</p>
    {% else %}
        <ul class="notification-list">
            {% for notification in notifications %}
                {% if notification.reminder %}
                    {% set type = notification.reminder.type %}
                    <li class="card notification notification-{{ type.value }} {{ notification.read ? '' : 'is-unread' }}">
                        <span class="pict {{ type.calendar ? '' : 'pict-frost' }}"><twig:Icon :name="type.pictogram" :size="18"/></span>
                        <div>
                            <span class="tag tag-{{ type.value }}">{{ type|trans }}</span>
                            <p>{{ notification.message }}</p>
                            <p class="meta"><twig:Reminder:PlantLink :plant="notification.reminder.plant" :plantingIds="planting_ids"/> · {{ notification.createdAt|day_and_time }}</p>
                        </div>
                    </li>
                {% else %}
                    {# A new member, with the invitation of the recipient #}
                    <li class="card notification notification-member {{ notification.read ? '' : 'is-unread' }}">
                        <span class="pict"><twig:Icon name="people" :size="18"/></span>
                        <div>
                            <span class="tag tag-member">{{ 'notification.new_member.tag'|trans }}</span>
                            <p>{{ notification.message }}</p>
                            <p class="meta"><a href="{{ path('garden_members', {id: notification.garden.id}) }}">{{ 'toast.see_members'|trans }}</a> · {{ notification.createdAt|day_and_time }}</p>
                        </div>
                    </li>
                {% endif %}
            {% endfor %}
        </ul>
    {% endif %}
</div>
<twig:Specimen plate="tecoma-ceramensis"/>
</div>
{% endblock %}
