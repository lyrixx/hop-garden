{% extends 'base.html.twig' %}

{% block title %}Notifications · Hop Garden{% endblock %}

{% block body %}
<div class="with-specimen">
<div>
    <twig:PlateHead tab="IV" title="Notifications" subtitle="Pruning, deadheading and cuttings on the first day of their months, frost when the forecast gets colder than a plant can bear."/>
    {% if notifications is empty %}
        <p class="callout">Nothing yet. Reminders are checked every day at 7:00.</p>
    {% else %}
        <ul class="notification-list">
            {% for notification in notifications %}
                {% set plant = notification.reminder.plant %}
                {% set type = notification.reminder.type %}
                <li class="card notification notification-{{ type.value }} {{ notification.read ? '' : 'is-unread' }}">
                    <span class="pict {{ type.calendar ? '' : 'pict-frost' }}"><twig:Icon :name="type.pictogram" :size="18"/></span>
                    <div>
                        <span class="tag tag-{{ type.value }}">{{ type.label }}</span>
                        <p>{{ notification.message }}</p>
                        <p class="meta"><a href="{{ my_plant_path(plant, planting_ids) ?? path('plant_show', {id: plant.id}) }}">{{ plant.commonName }}</a> · {{ notification.createdAt|date('l j F, H:i') }}</p>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
<twig:Specimen plate="tecoma-ceramensis"/>
</div>
{% endblock %}
