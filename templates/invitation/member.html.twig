{% extends 'base.html.twig' %}

{% block title %}{{ 'invitation.member.title'|trans({garden: garden.name}) }} · Hop Garden{% endblock %}

{# The link of an invitation, opened by a member of its garden: whatever its status, their garden #}
{% block body %}
<div class="with-specimen auth">
<div>
    <header class="plate-head">
        <span class="plate-tab">{{ 'invitation.tab'|trans }}</span>
        <h1>{{ 'invitation.member.title'|trans({garden: garden.name}) }}</h1>
    </header>

    <section class="card crowned auth-note">
        <span class="pict"><twig:Icon name="check" :size="18"/></span>
        <div>
            <p>{{ 'invitation.member.body'|trans({garden: garden.name}) }}</p>
            <twig:Button href="{{ path('garden', {garden: garden.slug}) }}" class="button-next">{{ 'invitation.member.open'|trans({garden: garden.name}) }}</twig:Button>
        </div>
    </section>
</div>
<twig:Specimen plate="wormia-subsessilis"/>
</div>
{% endblock %}
