{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.species'|trans }} · Hop Garden{% endblock %}

{% block body %}
<div class="with-specimen">
<div>
    <nav class="breadcrumb"><span class="page-label page-label-species">{{ 'species.label'|trans }}</span> {{ 'species.all'|trans }}</nav>
    <twig:PlateHead tab="III" :title="'nav.species'|trans" :subtitle="'species.index.subtitle'|trans"/>
    <p class="species-index-actions">
        <twig:Button href="{{ path('plant_new') }}" icon="note" :iconSize="18" class="button-light button-next">{{ 'species.new'|trans }}</twig:Button>
        <span class="callout">{{ 'species.index.or_ask'|trans({link: '<a href="' ~ path('chat', {message: 'chat.message.draft_new_species'|trans}) ~ '">', link_end: '</a>'})|raw }}</span>
    </p>

    {% set validated = entries|filter(entry => entry.plant.validated) %}
    {% set drafts = entries|filter(entry => not entry.plant.validated) %}
    {% if entries is empty %}
        <p class="callout">{{ 'species.index.empty'|trans({link: '<a href="' ~ path('plant_new') ~ '">', link_end: '</a>'})|raw }}</p>
    {% endif %}
    {% for section in [
        {id: 'validated', title: 'species.index.validated'|trans, entries: validated},
        {id: 'drafts', title: 'species.index.drafts'|trans, entries: drafts},
    ] %}
        {% if section.entries is not empty %}
            <section class="species-index-section" id="species-{{ section.id }}">
                <h2>{{ section.title }}</h2>
                <ul class="species-list">
                    {% for entry in section.entries %}
                        {% set plant = entry.plant %}
                        {% set plate = plate(plant.scientificName) %}
                        <li class="card species-row {{ plant.validated ? 'is-validated' : 'is-draft' }}">
                            <a class="species-row-name" href="{{ path('plant_show', {id: plant.id}) }}">
                                <img class="species-summary-plate" src="{{ asset(plate.image) }}" alt="{{ plate.depicts ?? 'plate.schematic_alt'|trans }}" width="{{ plate.width }}" height="{{ plate.height }}" loading="lazy">
                                <span>
                                    <strong>{{ plant.commonName }}</strong>
                                    <em class="latin">{{ plant.scientificName }}</em>
                                    {% if plant.family %}<span class="kicker">{{ plant.family }}</span>{% endif %}
                                </span>
                            </a>
                            <twig:Status :validated="plant.validated">{{ (plant.validated ? 'status.care_sheet_validated' : 'status.draft_to_review')|trans }}</twig:Status>
                            <div class="species-row-plantings">
                                {% if entry.plantings is empty %}
                                    <p class="hint">{{ (plant.validated ? 'species.index.no_planting' : 'species.index.no_planting_draft')|trans }}</p>
                                {% else %}
                                    <p class="kicker">{{ 'species.index.plantings'|trans({count: entry.plantings|length}) }}</p>
                                    <ul class="species-planting-list">
                                        {% for planting in entry.plantings %}
                                            <twig:Planting:Chip :planting="planting"/>
                                        {% endfor %}
                                    </ul>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}
    {% endfor %}
</div>
<twig:Specimen plate="gonystylus-miquelianus"/>
</div>
{% endblock %}
