{% extends 'base.html.twig' %}

{% block title %}{{ 'species.show.title'|trans({name: plant.commonName}) }} · Hop Garden{% endblock %}

{# Validated in its frame, the card unlocks its reminders; the rest of the page follows, in place #}
{% block head %}{{ turbo_refreshes_with('morph', 'preserve') }}{% endblock %}

{% block body %}
    <nav class="breadcrumb"><span class="page-label page-label-species">{{ 'species.label'|trans }}</span> <a href="{{ path('plant_index') }}">{{ 'species.all'|trans }}</a> › <em>{{ plant.scientificName }}</em></nav>
    <div data-controller="species" data-action="turbo:submit-end->species#submitted">
        <twig:PlantCard :plant="plant"/>
    </div>

    <section class="card species-plantings" id="in-your-garden">
        <header class="species-plantings-head">
            <h2>{{ 'status.in_garden'|trans }}</h2>
            {% if plant.validated %}
                <twig:Button href="{{ path('garden_new', {plant: plant.slug}) }}" icon="sprout" :iconSize="18" class="button-secondary">{{ 'action.add_to_my_garden'|trans }}</twig:Button>
            {% endif %}
        </header>
        {% if plantings is empty %}
            <p class="hint">{{ (plant.validated ? 'species.show.no_planting' : 'species.show.no_planting_draft')|trans }}</p>
        {% else %}
            <ul class="species-planting-list">
                {% for planting in plantings %}
                    <twig:Planting:Chip :planting="planting"/>
                {% endfor %}
            </ul>
            {% if plantings|length > 1 %}<p class="hint">{{ 'species.show.shared'|trans }}</p>{% endif %}
        {% endif %}
    </section>
{% endblock %}
