{% extends 'base.html.twig' %}

{% block title %}{{ plant.commonName }}, the species · Hop Garden{% endblock %}

{# Validated in its frame, the card unlocks its reminders; the rest of the page follows, in place #}
{% block head %}{{ turbo_refreshes_with('morph', 'preserve') }}{% endblock %}

{% block body %}
    <nav class="breadcrumb"><span class="page-label page-label-species">Species</span> <a href="{{ path('plant_index') }}">All species</a> › <em>{{ plant.scientificName }}</em></nav>
    <div data-controller="species" data-action="turbo:submit-end->species#submitted">
        <twig:PlantCard :plant="plant"/>
    </div>

    <section class="card species-plantings" id="in-your-garden">
        <header class="species-plantings-head">
            <h2>In your garden</h2>
            {% if plant.validated %}
                <twig:Button href="{{ path('garden_new', {plant: plant.id}) }}" icon="sprout" :iconSize="18" class="button-secondary">Add to my garden</twig:Button>
            {% endif %}
        </header>
        {% if plantings is empty %}
            <p class="hint">{{ plant.validated ? 'None of your plants follows this care sheet.' : 'Validate the card, then add your plant to the garden.' }}</p>
        {% else %}
            <ul class="species-planting-list">
                {% for planting in plantings %}
                    <twig:Planting:Chip :planting="planting"/>
                {% endfor %}
            </ul>
            {% if plantings|length > 1 %}<p class="hint">They share this care sheet, and so its reminders.</p>{% endif %}
        {% endif %}
    </section>
{% endblock %}
