{% extends 'base.html.twig' %}

{% block title %}{{ 'species.new'|trans }} · Hop Garden{% endblock %}

{% block body %}
    <header class="plate-head">
        <nav class="breadcrumb"><span class="page-label page-label-species">{{ 'species.label'|trans }}</span> <a href="{{ path('plant_index') }}">{{ 'species.all'|trans }}</a> › {{ 'species.new'|trans }}</nav>
        <h1>{{ 'species.new'|trans }}</h1>
        <p>{{ 'species.new_intro'|trans }}</p>
    </header>

    {{ form_start(form, {attr: {class: 'card crowned care-sheet-form garden-form'}}) }}
        {{ form_errors(form) }}

        <twig:SpeciesPicker :form="form" :required="true"/>

        <div class="actions">
            <twig:Button href="{{ path('plant_index') }}" class="button-secondary">{{ 'action.cancel'|trans }}</twig:Button>
            <twig:Button icon="note" :iconSize="18">{{ 'species.create_the_draft'|trans }}</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
