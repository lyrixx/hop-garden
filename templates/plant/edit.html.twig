{% extends 'base.html.twig' %}

{% block title %}{{ (plant.validated ? 'care_sheet.edit.title' : 'care_sheet.review.title')|trans({name: plant.commonName}) }} · Hop Garden{% endblock %}

{% block body %}
    <header class="plate-head">
        <nav class="breadcrumb"><span class="page-label page-label-species">{{ 'species.label'|trans }}</span> <a href="{{ path('plant_index') }}">{{ 'species.all'|trans }}</a> › <a href="{{ path('plant_show', {plant: plant.slug}) }}"><em>{{ plant.scientificName }}</em></a> › {{ (plant.validated ? 'action.edit' : 'action.review')|trans }}</nav>
        <h1>{{ (plant.validated ? 'care_sheet.edit.heading' : 'care_sheet.review.page_heading')|trans({species: '<em>' ~ plant.scientificName|e ~ '</em>'})|raw }}</h1>
        <p>{{ 'care_sheet.edit.verified'|trans }}{% if not plant.validated %} {{ 'care_sheet.review.reminders_wait'|trans }}{% endif %}</p>
    </header>

    {{ include('plant/_form.html.twig', {cancel_url: path('plant_show', {plant: plant.slug})}) }}
{% endblock %}
