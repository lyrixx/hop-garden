{% extends 'base.html.twig' %}

{% block title %}{{ plant.validated ? 'Edit' : 'Review' }} {{ plant.commonName }} · Hop Garden{% endblock %}

{% block body %}
    <header class="plate-head">
        <nav class="breadcrumb"><span class="page-label page-label-species">Species</span> <a href="{{ path('plant_index') }}">All species</a> › <a href="{{ path('plant_show', {id: plant.id}) }}"><em>{{ plant.scientificName }}</em></a> › {{ plant.validated ? 'Edit' : 'Review' }}</nav>
        <h1>{{ plant.validated ? 'Edit' : 'Review the draft of' }} <em>{{ plant.scientificName }}</em></h1>
        <p>A value you change counts as verified (high confidence).{% if not plant.validated %} Its reminders wait until you validate the draft.{% endif %}</p>
    </header>

    {{ include('plant/_form.html.twig', {cancel_url: path('plant_show', {id: plant.id})}) }}
{% endblock %}
