{% extends 'base.html.twig' %}

{% block title %}{{ 'reset_password.request.title'|trans }} · Hop Garden{% endblock %}

{% block body %}
<div class="with-specimen auth">
<div>
    <header class="plate-head">
        <nav class="breadcrumb"><a href="{{ path('login') }}">{{ 'login.title'|trans }}</a> › {{ 'reset_password.request.title'|trans }}</nav>
        <h1>{{ 'reset_password.request.title'|trans }}</h1>
        <p>{{ 'reset_password.request.subtitle'|trans }}</p>
    </header>

    {{ form_start(form, {attr: {class: 'card crowned care-sheet-form auth-form'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.email) }}
        <div class="actions">
            <twig:Button class="button-next">{{ 'reset_password.request.submit'|trans }}</twig:Button>
        </div>
    {{ form_end(form) }}
</div>
<twig:Specimen plate="wormia-subsessilis"/>
</div>
{% endblock %}
