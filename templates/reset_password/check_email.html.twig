{% extends 'base.html.twig' %}

{% block title %}{{ 'reset_password.check_email.title'|trans }} · Hop Garden{% endblock %}

{% block body %}
<div class="with-specimen auth">
<div>
    <header class="plate-head">
        <h1>{{ 'reset_password.check_email.title'|trans }}</h1>
    </header>

    <section class="card crowned auth-note">
        <span class="pict"><twig:Icon name="mail" :size="18"/></span>
        <div>
            <p>{{ 'reset_password.check_email.body'|trans }}</p>
            <p class="hint">{{ 'registration.check_email.spam'|trans }}</p>
            <p><a href="{{ path('login') }}">{{ 'reset_password.back_to_login'|trans }}</a></p>
        </div>
    </section>
</div>
<twig:Specimen plate="wormia-subsessilis"/>
</div>
{% endblock %}
