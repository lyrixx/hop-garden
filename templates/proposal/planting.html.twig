{% extends 'base.html.twig' %}

{% block title %}Add {{ proposal.name }} to my garden · Hop Garden{% endblock %}

{# The card of App\Controller\ProposalController as a page: the URL propose_planting gives an external MCP client #}
{% block body %}
    <header class="plate-head">
        <nav class="breadcrumb"><a href="{{ path('garden') }}">My garden</a> › Add a plant</nav>
        <h1>Add to my garden</h1>
        <p>Your assistant proposes this plant. Nothing is added until you tap the card.</p>
    </header>
    <twig:Proposal:PlantingCard :proposal="proposal" :planting="planting" :plant="plant" :space="space" :form="form ?? null" :unavailable="unavailable ?? null"/>
{% endblock %}
