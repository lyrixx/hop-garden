{% extends 'base.html.twig' %}

{% block title %}{{ 'proposal.space.title'|trans({name: proposal.name}) }} · Hop Garden{% endblock %}

{# The card of App\Controller\ProposalController as a page: the URL propose_space gives an external MCP client #}
{% block body %}
    <header class="plate-head">
        <nav class="breadcrumb"><a href="{{ path('spaces') }}">{{ 'nav.spaces'|trans }}</a> › {{ 'space.new'|trans }}</nav>
        <h1>{{ 'proposal.space.heading'|trans }}</h1>
        <p>{{ 'proposal.space.intro'|trans }}</p>
    </header>
    <twig:Proposal:SpaceCard :proposal="proposal" :space="space" :form="form ?? null"/>
{% endblock %}
