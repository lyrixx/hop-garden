{# The pieces of the emails, in inline styles: see layout.html.twig #}

{# The aubergine pill of the application, then the link written out, for the text part and the clients that hide
   the button #}
{% macro button(url, label) %}
    <p style="margin: 24px 0;"><a href="{{ url }}" style="display: inline-block; padding: 12px 24px; border-radius: 999px; background: #5b2a6e; color: #ffffff; font-weight: bold; text-decoration: none;">{{ label }}</a></p>
    <p style="margin: 0 0 16px; color: #56625b; font-size: 13px; word-break: break-all;">{{ 'email.layout.copy_link'|trans }}<br><a href="{{ url }}" style="color: #5b2a6e;">{{ url }}</a></p>
{% endmacro %}

{% macro note(text) %}
    <p style="margin: 16px 0 0; color: #56625b; font-size: 14px;">{{ text }}</p>
{% endmacro %}
