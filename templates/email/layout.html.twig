{#
    The frame of the emails of App\Account\AccountMailer: the green ground and the white card of Hop Garden, in inline
    styles only (the mail clients drop the others). No text template: App\Account\HtmlToTextConverter makes the text
    part out of this one, so every link is written out too (_ui.html.twig).
    locale: string, of the email
#}
<!DOCTYPE html>
<html lang="{{ locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ email.subject }}</title>
    </head>
    <body style="margin: 0; padding: 0; background: #0b5b3a;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: #0b5b3a;">
            <tr>
                <td align="center" style="padding: 32px 12px;">
                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px;">
                        <tr>
                            <td style="padding: 0 8px 16px; color: #ffffff; font-family: Georgia, 'Times New Roman', serif; font-size: 24px; font-weight: bold;">Hop Garden</td>
                        </tr>
                        <tr>
                            <td style="padding: 28px 32px; border-radius: 24px; background: #ffffff; color: #1d2a23; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 16px; line-height: 1.55;">
                                {% block content %}{% endblock %}
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 16px 8px 0; color: #dcefe3; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size: 13px;">{{ 'email.layout.footer'|trans }}</td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
