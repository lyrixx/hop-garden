<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Hop Garden{% endblock %}</title>
        {# The body of the "hop" picto (templates/components/Icon.html.twig) and two dashes on each side. At 16 px, 1 px
           is 1.5 units: the inner end of each dash sits on a whole pixel, or the dashes blur #}
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22><circle cx=%2212%22 cy=%2212%22 r=%2212%22 fill=%22%230b5b3a%22/><path d=%22M12 5.5c-3.2 0-5 2.6-5 6.2 0 4.6 2.4 8.3 5 9.8 2.6-1.5 5-5.2 5-9.8 0-3.6-1.8-6.2-5-6.2z%22 transform=%22translate(4.8 4.11) scale(.6)%22 fill=%22%23fff%22/><path d=%22M6 9 3.75 8.25M6 15l-2.25.75M18 9l2.25-.75M18 15l2.25.75%22 stroke=%22%23fff%22 stroke-width=%223%22 stroke-linecap=%22round%22/></svg>">
        {# Turbo Drive: a cross-fade between the pages, where the browser can #}
        <meta name="view-transition" content="same-origin">
        {% block head %}{% endblock %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    </head>
    <body{% if app.user %} {{ stimulus_controller('mercure-cookie', {url: path('mercure_cookie')}) }}{% endif %}>
        <twig:LocaleBanner/>

        {# The navigation of the application; a public page has its own (templates/public/layout.html.twig) #}
        {% block header %}
        <header class="topbar">
            <a class="brand" href="{{ path(is_granted('ROLE_USER') ? 'chat' : 'home') }}">
                <span class="pict"><twig:Icon name="hop" :size="32"/></span>
                <span>Hop Garden</span>
            </a>
            {% set route = app.current_route %}
            {% if is_granted('ROLE_USER') %}
            <nav class="nav">
                <a href="{{ path('chat') }}" class="{{ route == 'chat' ? 'active' }}"><twig:Icon name="chat" :size="18"/> {{ 'nav.assistant'|trans }}</a>
                <a href="{{ path('garden') }}" class="{{ route starts with 'garden' ? 'active' }}"><twig:Icon name="sprout" :size="18"/> {{ 'nav.garden'|trans }}</a>
                <a href="{{ path('plant_index') }}" class="{{ route starts with 'plant_' ? 'active' }}"><twig:Icon name="flower" :size="18"/> {{ 'nav.species'|trans }}</a>
                <a href="{{ path('spaces') }}" class="{{ route starts with 'space' ? 'active' }}"><twig:Icon name="grid" :size="18"/> {{ 'nav.spaces'|trans }}</a>
                <a href="{{ path('notifications') }}" class="{{ route == 'notifications' ? 'active' }}">
                    <twig:Icon name="bell" :size="18"/> {{ 'nav.notifications'|trans }}
                    <twig:Notification:Badge :unread="unread_notification_count()"/>
                </a>
            </nav>
            <twig:AccountMenu/>
            {% else %}
            {# Visitors: the pages of the account only #}
            <nav class="nav nav-visitor">
                <a href="{{ path('login') }}" class="{{ route == 'login' ? 'active' }}">{{ 'nav.log_in'|trans }}</a>
                <a href="{{ path('register') }}" class="{{ route starts with 'register' ? 'active' }}">{{ 'nav.register'|trans }}</a>
            </nav>
            {% endif %}
        </header>

        {# Reminders pushed by the worker show up as toasts, on every page: the ones of the member in their current garden.
           Both survive a Turbo Drive visit: the toasts on screen stay, and the stream is not closed and opened again,
           until the member switches to another garden. Every page renews their subscriber cookie of the Mercure hub #}
        {% if is_granted('ROLE_USER') %}
        {{ grant_mercure_topics() }}
        {% set notifications_topic = notifications_topic() %}
        {% if notifications_topic %}
        <div class="toasts" id="toasts" data-turbo-permanent aria-live="polite"></div>
        <div id="notifications-stream-{{ current_garden().id }}" data-turbo-permanent hidden>{{ turbo_stream_from(notifications_topic, private: true) }}</div>
        {% endif %}
        {% endif %}
        {% endblock %}

        <main class="main">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="card flash flash-{{ type }}">{{ message|trans }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="footer">
            <twig:Legal:Links/>
            <p>
                {{ 'footer.plant_data'|trans({trefle: '<a href="https://trefle.io">Trefle</a>'})|raw }}
                {{ 'footer.weather_data'|trans({open_meteo: '<a href="https://open-meteo.com/">Open-Meteo.com</a>', license: '<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>'})|raw }}
                {{ 'footer.reviewed'|trans }}
            </p>
            <p>{{ 'footer.plates'|trans({library: '<a href="https://www.flickr.com/photos/biodivlibrary/">Biodiversity Heritage Library</a>'})|raw }}</p>
            {% if app_demo %}<p><span class="demo-mode">{{ 'footer.demo_mode'|trans }}</span></p>{% endif %}
            <twig:LocaleSwitch/>
        </footer>
    </body>
</html>
