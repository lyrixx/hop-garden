{#
    A public page, open to anyone: the home page and the legal pages. Its own top bar (the language, Log in and the call
    to join, or the garden of a member), no navigation of the application, no reminder toasts.
#}
{% extends 'base.html.twig' %}

{% block header %}
    <header class="topbar public-topbar">
        <a class="brand" href="{{ path('home') }}">
            <span class="pict"><twig:Icon name="hop" :size="32"/></span>
            <span>Hop Garden</span>
        </a>
        <nav class="public-nav" aria-label="{{ 'public.nav'|trans }}">
            <twig:LocaleSwitch :short="true"/>
            {% if is_granted('ROLE_USER') %}
                {# Their garden, on a phone too: a legal page has no hero #}
                <twig:Public:JoinButton class="button-light"/>
            {% else %}
                <a class="public-nav-link" href="{{ path('login') }}">{{ 'public.log_in'|trans }}</a>
                <twig:Public:JoinButton class="button-light public-nav-join"/>
            {% endif %}
        </nav>
    </header>
{% endblock %}
