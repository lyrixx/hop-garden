{#
    The garden of the page at the start of the menu of the member (the last one on a page out of a garden): its members,
    its settings for its owner and, from two gardens on, the others, each a link to the same page in it, or to its
    assistant (garden_switch_path(); App\Controller\GardenMembersController). Nothing before the first one: the wizard
    makes it. No prop.
#}
{% set current = nav_garden() %}
{% if current %}
    {% set gardens = member_gardens() %}
    {% set members_path = path('garden_members', {garden: current.slug}) %}
    {% if gardens|length > 1 %}
        <details class="garden-switcher">
            <summary class="account-menu-item" title="{{ 'nav.garden_switch'|trans }}"><twig:Icon name="people" :size="18"/><span class="account-menu-label">{{ current.name }}</span></summary>
            <ul class="card garden-switcher-list">
                {% for garden in gardens %}
                    <li>
                        {% if garden == current %}
                            <span class="garden-switcher-current" aria-current="true"><twig:Icon name="check" :size="16"/> {{ garden.name }}</span>
                        {% else %}
                            <a href="{{ garden_switch_path(garden) }}">{{ garden.name }}</a>
                        {% endif %}
                    </li>
                {% endfor %}
                <li class="garden-switcher-members"><a href="{{ members_path }}">{{ 'nav.garden_members'|trans({garden: current.name}) }}</a></li>
                <li><a href="{{ path('garden_create') }}">{{ 'nav.garden_new'|trans }}</a></li>
            </ul>
        </details>
    {% else %}
        <a href="{{ members_path }}" class="account-menu-item garden-name{{ app.current_route == 'garden_members' ? ' active' }}" title="{{ 'nav.garden_members'|trans({garden: current.name}) }}"><twig:Icon name="people" :size="18"/><span class="account-menu-label">{{ current.name }}</span></a>
    {% endif %}
    {% if current.ownedBy(app.user) %}
        <a href="{{ path('garden_settings', {garden: current.slug}) }}" class="account-menu-item{{ app.current_route == 'garden_settings' ? ' active' }}" title="{{ 'nav.garden_settings'|trans }}"><twig:Icon name="pencil" :size="18"/><span class="visually-hidden">{{ 'nav.garden_settings'|trans }}</span></a>
    {% endif %}
{% endif %}
