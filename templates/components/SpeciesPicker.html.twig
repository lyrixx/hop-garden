{#
    A name and its species (App\Twig\Components\SpeciesPicker). The fields come from the form, at mount only: the morph
    leaves them alone (data-live-ignore) and the live controller sets their values from the props (data-model). The
    chips update the trefleId prop; the component finds the scientific name. Required, for a new species: the assistant
    is offered instead, with the name as typed.
#}
<div{{ attributes.defaults({class: 'garden-species'}) }}>
    <div data-live-ignore>
        {%- if form -%}
            {{ form_row(form.name, {attr: {'data-model': 'debounce(300)|name'}}) }}
            {{ form_widget(form.trefleId, {type: 'hidden', attr: {'data-model': 'trefleId'}}) }}
            {{ form_widget(form.scientificName, {attr: {'data-model': 'scientificName'}}) }}
        {%- endif -%}
    </div>
    <p class="garden-species-chosen" {{ scientificName is null ? 'hidden' }}>
        <span class="kicker">{{ 'species.label'|trans }}</span> <em>{{ scientificName }}</em>
        <button type="button" class="chip" data-action="live#update" data-model="trefleId" data-value="">{{ 'species_picker.change'|trans }}</button>
    </p>
    {% set result = this.searchResult %}
    <div class="garden-species-candidates" aria-live="polite">
        {%- if result is not null -%}
            {%- if result.trefleUnavailable -%}
                <p class="hint">{{ (required ? 'species_picker.unavailable_required' : 'species_picker.unavailable')|trans }}</p>
            {%- elseif result.latinNamesQuotaReached -%}
                <p class="hint">{{ 'species_picker.quota_reached'|trans }}</p>
            {%- elseif result.candidates is empty -%}
                <p class="hint">{{ (required ? 'species_picker.unknown_required' : 'species_picker.unknown')|trans }}</p>
            {%- else -%}
                <p class="kicker garden-species-label">{{ (required ? 'species_picker.which' : 'species_picker.which_optional')|trans }}</p>
                {%- for candidate in result.candidates -%}
                    <button type="button" class="chip" data-action="live#update" data-model="trefleId" data-value="{{ candidate.trefleId }}"><em>{{ candidate.scientificName }}</em>{{ candidate.commonName ? ' · ' ~ candidate.commonName }}</button>
                {%- endfor -%}
            {%- endif -%}
        {%- endif -%}
    </div>
    {%- if required -%}
        {% set subject = scientificName ?? (name|trim is not empty ? name|trim : null) %}
        <p class="hint garden-species-assistant">{{ 'species_picker.rather_not'|trans }} <a href="{{ path('chat', {message: subject is null ? 'chat.message.draft_new_species'|trans : 'chat.message.draft_species'|trans({species: subject})}) }}">{{ 'species_picker.ask_the_assistant'|trans }}</a></p>
    {%- endif -%}
</div>
