{#
    An "Add to my garden" card (App\Controller\ProposalController), in its Turbo Frame: its species, its space and its
    name, then "Added" once tapped. In the chat, the added card tells the agent (data-chat-notice, see
    chat_controller.js).
    proposal: App\Garden\Model\PlantingProposal · planting: ?App\Garden\Entity\Planting, once added · plant:
    ?App\Plant\Entity\Plant, its species · space: ?App\Garden\Entity\Space · form: ?FormView, until added · unavailable:
    ?Symfony\Contracts\Translation\TranslatableInterface, why it can no longer be added
#}
{%- props proposal, planting = null, plant = null, space = null, form = null, unavailable = null -%}
{% set plate = plant ? plate(plant.scientificName) : null %}
<turbo-frame id="planting-proposal-{{ proposal.proposalId }}">
<article class="card proposal-card {{ planting ? 'is-done' }}"
    {#- In the language of the interface, as the bubble of the user shows it (config/agent/gardener.md) #}
    {%- if planting %} data-chat-notice="{{ planting.space ? 'chat.notice.planting_added_in_space'|trans({name: planting.name, space: planting.space.name}) : 'chat.notice.planting_added'|trans({name: planting.name}) }}"{% endif %}>
    <header class="proposal-card-head">
        <span class="proposal-card-figure">
            {%- if plate -%}
                <img src="{{ asset(plate.image) }}" alt="" width="{{ plate.width }}" height="{{ plate.height }}" loading="lazy">
            {%- else -%}
                <twig:Icon name="hop" :size="37"/>
            {%- endif -%}
        </span>
        <div>
            <p class="kicker">{{ (planting ? 'planting.label' : 'action.add_to_my_garden')|trans }}</p>
            <h3>{{ planting ? planting.name : proposal.name }}</h3>
        </div>
        {% if planting %}<twig:Status :validated="true">{{ 'status.added'|trans }}</twig:Status>{% endif %}
    </header>

    <dl class="proposal-facts">
        <div>
            <dt><span class="pict"><twig:Icon name="note" :size="15"/></span> {{ 'species.label'|trans }}</dt>
            <dd>{% if plant %}<a href="{{ path('plant_show', {garden: plant.garden.slug, plant: plant.slug}) }}" data-turbo-frame="_top"><em>{{ plant.scientificName }}</em></a> · {{ plant.commonName }}{% else %}{{ 'species.unknown'|trans }}{% endif %}</dd>
        </div>
        <div>
            <dt><span class="pict"><twig:Icon name="grid" :size="15"/></span> {{ 'space.label'|trans }}</dt>
            <dd>
                {%- if space -%}
                    <a href="{{ path('space_show', {garden: space.garden.slug, space: space.slug}) }}" data-turbo-frame="_top">{{ space.name }}</a> <twig:Space:Conditions :space="space"/>
                {%- else -%}
                    {{ 'space.none'|trans }}
                {%- endif -%}
            </dd>
        </div>
    </dl>

    {% if planting %}
        <div class="actions">
            <twig:Button href="{{ path('garden_show', {garden: planting.garden.slug, planting: planting.slug}) }}" icon="sprout" class="button-next" data-turbo-frame="_top">{{ 'action.see_my_plant'|trans }}</twig:Button>
        </div>
    {% elseif unavailable %}
        <p class="warning">{{ unavailable|trans }}</p>
    {% elseif form %}
        {{ form_start(form, {attr: {class: 'proposal-form', 'data-chat-follow-up': ''}}) }}
            {{ form_row(form.name) }}
            <div class="actions">
                <twig:Button icon="sprout" :iconSize="18">{{ 'action.add_to_my_garden'|trans }}</twig:Button>
            </div>
        {{ form_end(form) }}
    {% endif %}
</article>
</turbo-frame>
