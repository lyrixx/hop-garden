{#
    A line pictogram on a 24px grid.
    name: string, one of the cases below · size: int, in px
#}
{%- props name, size = 20 -%}
<svg class="icon icon-{{ name }}" viewBox="0 0 24 24" width="{{ size }}" height="{{ size }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {%- if name == 'hop' -%}
        {# The logo, "hop hop hop": the drawing and its motion dashes, scaled by 3/4 to make room for the dashes. Render
           it at 4/3 of the size of a picto and the drawing keeps its size. Keep in sync with
           video/src/components/Hop.tsx, and with the favicon in templates/base.html.twig #}
        <g transform="translate(3 3) scale(.75)"><path d="M12 2.5v3"/><path d="M12 5.5c-3.2 0-5 2.6-5 6.2 0 4.6 2.4 8.3 5 9.8 2.6-1.5 5-5.2 5-9.8 0-3.6-1.8-6.2-5-6.2z"/><path d="M7.4 9.8c1.6 1.1 3 1.3 4.6 1.3s3-.2 4.6-1.3"/><path d="M7.2 13.6c1.7 1.2 3.2 1.5 4.8 1.5s3.1-.3 4.8-1.5"/><path d="M8.3 17.3c1.3.9 2.5 1.1 3.7 1.1s2.4-.2 3.7-1.1"/><path d="M12 5.5v15.8"/><path d="M12 4c2-2 4.6-2 6.2-.9-.6 2.3-3 3.4-5.2 2.9"/><path d="M2.37 8.39.68 7.78M2.37 15.41.68 16.02M21.63 8.39 23.32 7.78M21.63 15.41 23.32 16.02"/></g>
    {%- elseif name == 'sun' -%}
        <circle cx="12" cy="12" r="4.2"/><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M5.5 18.5l1.7-1.7M16.8 7.2l1.7-1.7"/>
    {%- elseif name == 'part_shade' -%}
        <path d="M12 7.8a4.2 4.2 0 1 0 0 8.4z" fill="currentColor"/><circle cx="12" cy="12" r="4.2"/><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M5.5 5.5l1.7 1.7M5.5 18.5l1.7-1.7"/>
    {%- elseif name == 'shade' -%}
        <path d="M7 18.5h9.5a4 4 0 0 0 .4-8 5.5 5.5 0 0 0-10.6 1.4A3.3 3.3 0 0 0 7 18.5z"/><path d="M4 21.5h16"/>
    {%- elseif name == 'drop' -%}
        <path d="M12 3.2c3.3 4.2 5.6 7.4 5.6 10.4a5.6 5.6 0 0 1-11.2 0c0-3 2.3-6.2 5.6-10.4z"/><path d="M9.4 14.6a2.7 2.7 0 0 0 2.4 2.4"/>
    {%- elseif name == 'snowflake' -%}
        <path d="M12 2.8v18.4M4 7.4l16 9.2M4 16.6l16-9.2"/><path d="M9.6 4.6 12 6.8l2.4-2.2M9.6 19.4 12 17.2l2.4 2.2M4.2 10.4l3.1.9-.7-3.2M19.8 13.6l-3.1-.9.7 3.2M4.2 13.6l3.1-.9-.7 3.2M19.8 10.4l-3.1.9.7-3.2"/>
    {%- elseif name == 'secateurs' -%}
        <circle cx="7" cy="17.5" r="2.6"/><circle cx="13.2" cy="19.6" r="2.6"/><path d="M8.6 15.4 18.7 4.2c.5-.6 1.5-.5 1.8.2.2.4.1.9-.2 1.2L11.2 16.9"/><path d="M12.3 12.2 15 8.6"/>
    {%- elseif name == 'flower' -%}
        <circle cx="12" cy="9" r="2"/><path d="M12 7a2.6 2.6 0 1 1 2.6-2.6M14 9a2.6 2.6 0 1 1 1.4 4.7M12 11a2.6 2.6 0 1 1-3.4 2.7M10 9a2.6 2.6 0 1 1-.2-4.9"/><path d="M12 11.5v10M12 17c-2.5 0-4-1.4-4.6-3.4M12 19c2.3-.2 3.6-1.5 4-3.4"/>
    {%- elseif name == 'sprout' -%}
        <path d="M12 21v-8.5"/><path d="M12 12.5C12 8.5 9.5 6 5 6c0 4 2.6 6.5 7 6.5z"/><path d="M12 15c0-3.5 2.4-5.8 6.6-5.8 0 3.5-2.5 5.8-6.6 5.8z"/><path d="M7.5 21h9"/>
    {%- elseif name == 'bell' -%}
        <path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.6 1.8H4.4z"/><path d="M10 20.5a2.2 2.2 0 0 0 4 0"/>
    {%- elseif name == 'bee' -%}
        <ellipse cx="12" cy="14" rx="4.2" ry="5.6"/><path d="M8 12.4h8M7.9 15.4h8.2M9 18.2h6"/><path d="M10.2 8.9C8.6 5.6 5.4 5 3.8 6.4c-.9 1.9.6 4.5 4.6 5.1"/><path d="M13.8 8.9c1.6-3.3 4.8-3.9 6.4-2.5.9 1.9-.6 4.5-4.6 5.1"/><path d="M10.6 8.6 9.4 5.8M13.4 8.6l1.2-2.8"/>
    {%- elseif name == 'chat' -%}
        <path d="M4.5 5.5h15v10h-8l-4.5 3.5v-3.5H4.5z"/><path d="M8 9.5h8M8 12.5h5"/>
    {%- elseif name == 'grid' -%}
        <rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>
    {%- elseif name == 'check' -%}
        <path d="M5 12.5 10 17.5 19 7"/>
    {%- elseif name == 'pencil' -%}
        <path d="M15.5 4.5 19.5 8.5 8.5 19.5H4.5v-4z"/><path d="M13 7l4 4"/>
    {%- elseif name == 'globe' -%}
        <circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.3 3.6 5.1 3.6 8.5s-1.2 6.2-3.6 8.5c-2.4-2.3-3.6-5.1-3.6-8.5s1.2-6.2 3.6-8.5z"/>
    {%- elseif name == 'user' -%}
        <circle cx="12" cy="8.5" r="3.8"/><path d="M4.8 20c.9-3.6 3.8-5.6 7.2-5.6s6.3 2 7.2 5.6"/>
    {%- elseif name == 'logout' -%}
        <path d="M13.5 4.5h-7v15h7"/><path d="M10.5 12h9.5M16.8 8.6 20.2 12l-3.4 3.4"/>
    {%- elseif name == 'shield' -%}
        <path d="M12 3.5 5 6.2v5.3c0 4.3 2.9 7.6 7 9 4.1-1.4 7-4.7 7-9V6.2z"/><path d="M9 12.2l2.1 2.1 3.9-4"/>
    {%- elseif name == 'mail' -%}
        <rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4.5 7 7.5 6 7.5-6"/>
    {%- elseif name == 'note' -%}
        <path d="M6 3.5h9l3.5 3.5v13.5H6z"/><path d="M14.5 3.5V7.5h4M9 12h6M9 15.5h6"/>
    {%- elseif name == 'people' -%}
        <circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5c.6-3.4 2.7-5.5 5.5-5.5s4.9 2.1 5.5 5.5"/><circle cx="16.8" cy="9.6" r="2.4"/><path d="M15.6 14.3c2.6-.3 4.4 1.5 4.9 4.6"/>
    {%- elseif name == 'plug' -%}
        <path d="M9 3.5V8M15 3.5V8"/><path d="M6.5 8h11v3.5a5.5 5.5 0 0 1-11 0z"/><path d="M12 17v3.5"/>
    {%- endif -%}
</svg>
