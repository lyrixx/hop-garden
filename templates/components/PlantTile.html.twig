{#
    A plant of the garden, as a tile: its photo, its name, its species, then where its care sheet stands and its
    reminders.
    planting: App\Garden\Entity\Planting
#}
{% props planting %}
{% set plant = planting.plant %}
<a class="card plant-tile" href="{{ path('garden_show', {id: planting.id}) }}">
    <span class="specimen-no">{{ 'specimen.number'|trans({number: planting.id|specimen_number}) }}</span>
    <span class="plant-card-image"><twig:PlantingPhoto :planting="planting"/></span>
    <strong>{{ planting.name }}</strong>
    {% if planting.scientificName %}<em>{{ planting.scientificName }}</em>{% endif %}
    <span class="tags">
        {% if plant is null %}
            <span class="tag tag-pending">{{ 'status.care_sheet_in_progress'|trans }}</span>
        {% elseif not plant.validated %}
            <span class="tag tag-draft">{{ 'status.draft_to_validate'|trans }}</span>
        {% else %}
            <span class="tag tag-validated"><twig:Icon name="check" :size="13"/> {{ 'status.care_sheet'|trans }}</span>
            {% for type in plant.enabledReminderTypes %}<span class="tag tag-{{ type.value }}"><twig:Icon :name="type.pictogram" :size="13"/> {{ type|trans }}</span>{% else %}<span class="tag">{{ 'reminder.none'|trans }}</span>{% endfor %}
        {% endif %}
    </span>
</a>
