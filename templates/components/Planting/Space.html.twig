{#
    Where a planting grows, as rows of its table: its space, the exposure and the soil of the space, and its neighbours,
    the other plants of the space. Without a space, a link to choose one.
    planting: App\Garden\Entity\Planting
#}
{% props planting %}
{% set space = planting.space %}
<tr>
    <th scope="row"><span class="pict"><twig:Icon name="grid" :size="17"/></span> {{ 'space.label'|trans }}</th>
    <td>
        {%- if space -%}
            <a href="{{ path('space_show', {id: space.id}) }}">{{ space.name }}</a>
        {%- else -%}
            {{ 'planting.no_space'|trans({link: '<a href="' ~ path('garden_edit', {id: planting.id}) ~ '">' ~ 'planting.choose_space'|trans ~ '</a>'})|raw }}
        {%- endif -%}
    </td>
</tr>
{% if space %}
    <tr>
        <th scope="row"><span class="pict pict-sun"><twig:Icon :name="space.exposure ? space.exposure.value : 'sun'" :size="17"/></span> {{ 'space.exposure'|trans }}</th>
        <td>{{ space.exposure ? space.exposure|trans : 'space.not_recorded'|trans }}</td>
    </tr>
    <tr>
        <th scope="row"><span class="pict"><twig:Icon name="sprout" :size="17"/></span> {{ 'space.soil'|trans }}</th>
        <td>{{ space.soil ? space.soil|trans : 'space.not_recorded'|trans }}</td>
    </tr>
    <tr>
        <th scope="row"><span class="pict"><twig:Icon name="flower" :size="17"/></span> {{ 'planting.neighbours'|trans }}</th>
        <td>
            {% for neighbour in planting.neighbours %}
                <a href="{{ path('garden_show', {id: neighbour.id}) }}">{{ neighbour.name }}</a>{{ not loop.last ? ', ' -}}
            {% else %}
                {{ 'planting.no_neighbour'|trans({space: space.name}) }}
            {% endfor %}
        </td>
    </tr>
{% endif %}
