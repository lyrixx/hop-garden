{#
    The exposure and the soil of a space, as tags.
    space: App\Garden\Entity\Space
#}
{% props space %}
<span class="tags">
    {%- if space.exposure %}<span class="tag tag-exposure"><twig:Icon :name="space.exposure.value" :size="13"/> {{ space.exposure|trans }}</span>{% endif -%}
    {%- if space.soil %}<span class="tag tag-soil"><twig:Icon name="sprout" :size="13"/> {{ space.soil|trans }}</span>{% endif -%}
    {%- if not space.exposure and not space.soil %}<span class="tag">{{ 'space.conditions_not_recorded'|trans }}</span>{% endif -%}
</span>
