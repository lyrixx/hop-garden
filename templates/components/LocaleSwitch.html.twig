{#
    The language of the interface, in the footer and in the top bar of a public page: each one in its own name, the
    current one pressed.
    short: bool, the codes of the languages (EN, FR) rather than their names · The other attributes go on the form
#}
{%- props short = false -%}
<form{{ attributes.defaults({class: 'locale-switch'}) }} method="post" action="{{ path('locale') }}" aria-label="{{ 'locale.switch.label'|trans }}">
    <input type="hidden" name="_token" value="{{ csrf_token('locale') }}">
    <input type="hidden" name="returnTo" value="{{ app.request.requestUri }}">
    <twig:Icon name="globe" :size="15"/>
    {%- for locale in enum_cases('App\\Locale\\Model\\SupportedLocale') %}
        {%- set current = locale.value == app.request.locale %}
        <button type="submit" name="locale" value="{{ locale.value }}" lang="{{ locale.value }}" aria-pressed="{{ current ? 'true' : 'false' }}"{% if short %} title="{{ locale.nativeName }}" aria-label="{{ locale.nativeName }}"{% endif %}{{ current ? ' disabled' }}>{{ short ? locale.value|upper : locale.nativeName }}</button>
    {%- endfor %}
</form>
