{#
    Where the care sheet of a planting stands until it is validated: the assistant drafting it, then its draft waiting
    for a review. The worker refreshes the page once the draft is proposed (App\Garden\DraftCareSheetHandler).
    planting: App\Garden\Entity\Planting
#}
{% props planting %}
{% if planting.plant %}
    <p class="hint" data-drafting-target="drafted">{{ 'planting.draft_waiting'|trans }}</p>
{% elseif planting.drafting %}
    <p class="garden-pending" data-drafting-target="pending">{{ 'planting.drafting'|trans({name: planting.name}) }}</p>
{% endif %}
