{#
    The foot of a plant card: the review note, the sources and the credit of the figure, then the actions.
    plant: App\Plant\Entity\Plant · plate: App\Plate\Model\Plate, its figure
#}
{% props plant, plate %}
{% set sheet = plant.careSheet %}
<div class="plate-colophon">
    {% if not plant.validated %}
        {% if sheet.llmOnly %}
            <p class="warning">{{ 'plant_card.llm_only'|trans }}</p>
        {% elseif sheet.hasLlmKnowledge %}
            <p class="review-note">{{ 'plant_card.review'|trans }}</p>
        {% else %}
            {# Created by hand: its values are placeholders, until the user changes them #}
            <p class="review-note">{{ 'plant_card.fill_in'|trans }}</p>
        {% endif %}
    {% endif %}
    {% if plant.notes %}<p class="notes">{{ plant.notes }}</p>{% endif %}

    <p>
        {{ 'plant_card.sources'|trans }}
        {% for source in sheet.sources %}
            {%- if source.url %}<a href="{{ source.url }}" rel="noopener">{{ source|trans }}</a>{% else %}{{ source|trans }}{% endif %}{{ not loop.last ? ', ' }}
        {%- endfor %}
        · {{ 'plant_card.check_on'|trans({
            rhs: '<a href="https://www.rhs.org.uk/search?query=' ~ plant.scientificName|url_encode ~ '" rel="noopener">RHS</a>',
            snhf: '<a href="https://www.snhf.org/?s=' ~ plant.scientificName|url_encode ~ '" rel="noopener">SNHF</a>',
        })|raw }}
    </p>
    <p class="plate-credit">
        {% if plate.schematic %}
            {{ 'plant_card.schematic_credit'|trans }}
        {% else %}
            {{ 'plant_card.plate_credit'|trans({depicts: '<em>' ~ plate.depicts|e ~ '</em>', work: plate.work|e, published: plate.published|e})|raw }}
            {{ 'plant_card.plate_library'|trans({library: '<a href="' ~ plate.url|e('html_attr') ~ '" rel="noopener">Biodiversity Heritage Library</a>'})|raw }}
        {% endif %}
    </p>
</div>

<div class="actions">
    <twig:Button href="{{ path('plant_edit', {id: plant.id}) }}" icon="pencil" class="button-secondary">{{ 'action.edit'|trans }}</twig:Button>
    {% if plant.validated %}
        {% set my_plant_path = my_plant_path(plant) %}
        {% if my_plant_path %}
            <twig:Button href="{{ my_plant_path }}" icon="sprout" class="button-next" data-turbo-frame="_top">{{ 'action.see_my_plant'|trans }}</twig:Button>
        {% endif %}
    {% else %}
        <span class="hint">{{ 'plant_card.validate_for_reminders'|trans }}</span>
        <form method="post" action="{{ path('plant_validate', {id: plant.id}) }}" data-chat-follow-up>
            <input type="hidden" name="_token" value="{{ csrf_token('plant') }}">
            <twig:Button icon="check">{{ 'action.validate'|trans }}</twig:Button>
        </form>
    {% endif %}
</div>
