{# One value of the care sheet (App\Twig\Components\PlantCard\Row) #}
{% set months = this.months %}
{% set to_review = this.toReview %}
<tr class="row-{{ row.field.value }} {{ to_review ? 'needs-review' }}">
    <th scope="row">{{ row.field.label }}</th>
    <td>
        {% if months is not null %}
            <span class="month-ruler" aria-hidden="true">
                {%- for month in 1..12 -%}
                    <span class="{{ month in months ? 'is-on' }}">{{ month_name(month)|first }}</span>
                {%- endfor -%}
            </span>
            <span class="month-ruler-text">{{ row.value }}</span>
        {% else %}
            {{ row.value }}
        {% endif %}
    </td>
    {# Only the values to verify show their confidence #}
    {% if to_review %}
        <td class="confidence-cell"><twig:Confidence :confidence="row.confidence"/></td>
    {% endif %}
</tr>
