{#
    The name of a plant, linked to my plant of its species, in the garden, or to the species when several plants or
    none follow its care sheet.
    plant: App\Plant\Entity\Plant · plantingSlugs: array<string, list<string>>, see App\Garden\PlantingRepository::findSlugsForPlants()
#}
{%- props plant, plantingSlugs -%}
<a href="{{ my_plant_path(plant, plantingSlugs) ?? path('plant_show', {garden: plant.garden.slug, plant: plant.slug}) }}">{{ plant.commonName }}</a>
