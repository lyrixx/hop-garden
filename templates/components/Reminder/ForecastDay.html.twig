{#
    A day of the frost forecast: its minimum, and the plants colder than their frost threshold that day.
    day: App\Reminder\Model\ForecastDay · plantingSlugs: see Reminder:PlantLink
#}
{% props day, plantingSlugs %}
<li class="forecast-day {{ day.plantsAtRisk is empty ? '' : 'is-at-risk' }}">
    {# A forecast day is in the timezone of the garden #}
    <time class="forecast-date" datetime="{{ day.minimum.date|date('Y-m-d', false) }}">{{ day.minimum.date|day_and_month }}</time>
    <span class="forecast-min">{{ day.minimum.minTemperatureC|temperature }}</span>
    {% if day.plantsAtRisk is empty %}
        <p class="forecast-plants">{{ 'forecast.no_plant_at_risk'|trans }}</p>
    {% else %}
        <p class="forecast-plants"><span class="visually-hidden">{{ 'forecast.at_risk'|trans }}</span>
            {% for plant in day.plantsAtRisk %}
                <span class="tag tag-frost"><twig:Icon name="snowflake" :size="12"/><twig:Reminder:PlantLink :plant="plant" :plantingSlugs="plantingSlugs"/></span>
            {% endfor %}
        </p>
    {% endif %}
</li>
