{#
    A space of the garden, as a tile: its name, its exposure and soil, then the plants growing there.
    space: App\Garden\Entity\Space
#}
{% props space %}
<a class="card plant-tile space-tile" href="{{ path('space_show', {garden: space.garden.slug, space: space.slug}) }}">
    <span class="specimen-no">{{ 'specimen.number'|trans({number: space.id|specimen_number}) }}</span>
    <strong>{{ space.name }}</strong>
    <twig:Space:Conditions :space="space"/>
    <span class="space-tile-plants">
        {%- for planting in space.plantings -%}
            {{ planting.name }}{{ not loop.last ? ', ' }}
        {%- else -%}
            {{ 'space.no_plant_yet'|trans }}
        {%- endfor -%}
    </span>
</a>
