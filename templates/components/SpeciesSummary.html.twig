{#
    The species of my plant, in short, on the page of my plant: its plate and its names, a few facts of its care sheet,
    its reminders read only, and the way to its page, where the card is edited, validated and its reminders switched.
    No signed form: the worker renders it too, once the agent drafted the care sheet.
    plant: App\Plant\Entity\Plant
#}
{% props plant %}
{% set plate = plate(plant.scientificName) %}
{% set sheet = plant.careSheet %}
<section class="card species-summary {{ plant.validated ? 'is-validated' : 'is-draft' }}" id="species">
    <header class="species-summary-head">
        <span class="page-label page-label-species">Species</span>
        <twig:Status :validated="plant.validated">{{ plant.validated ? 'Care sheet validated' : 'Draft to review' }}</twig:Status>
    </header>
    <a class="species-summary-name" href="{{ path('plant_show', {id: plant.id}) }}">
        <img class="species-summary-plate" src="{{ asset(plate.image) }}" alt="{{ plate.depicts ?? 'Schematic figure of a flowering shrub' }}" width="{{ plate.width }}" height="{{ plate.height }}" loading="lazy">
        <span>
            <strong>{{ plant.commonName }}</strong>
            <em class="latin">{{ plant.scientificName }}</em>
            <span class="kicker">{{ plant.family }}</span>
        </span>
    </a>
    <ul class="species-facts">
        <li><twig:Icon name="snowflake" :size="14"/> Hardy down to {{ sheet.minTemperatureC }} °C{{ sheet.frostSensitive ? ', frost sensitive' }}</li>
        <li><twig:Icon :name="sheet.exposure.value" :size="14"/> {{ sheet.exposure.label }}</li>
        <li><twig:Icon name="drop" :size="14"/> {{ sheet.watering.label }} watering</li>
    </ul>
    <p class="species-reminders">
        {% if plant.validated %}
            <span class="kicker">Reminders</span>
            {% for type in plant.enabledReminderTypes %}<span class="tag tag-{{ type.value }}"><twig:Icon :name="type.pictogram" :size="13"/> {{ type.label }}</span>{% else %}<span class="tag">None</span>{% endfor %}
        {% else %}
            <span class="hint">Validate its care sheet to set reminders.</span>
        {% endif %}
    </p>
    <twig:Button href="{{ path('plant_show', {id: plant.id}) }}" icon="note" class="button-next">{{ plant.validated ? 'Species sheet and reminders' : 'Review and validate the care sheet' }}</twig:Button>
</section>
