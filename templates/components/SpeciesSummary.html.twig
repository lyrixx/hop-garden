{#
    The species of my plant, in short, on the page of my plant: its plate and its names, a few facts of its care sheet,
    its reminders read only, and the way to its page, where the card is edited, validated and its reminders switched.
    No signed form: the worker renders it too, once the agent drafted the care sheet.
    plant: App\Plant\Entity\Plant
#}
{% props plant %}
{% set plate = plate(plant.scientificName) %}
{% set sheet = plant.careSheet %}
<section class="card species-summary {{ plant.validated ? 'is-validated' : 'is-draft' }}" id="species">
    <header class="species-summary-head">
        <span class="page-label page-label-species">{{ 'species.label'|trans }}</span>
        <twig:Status :validated="plant.validated">{{ (plant.validated ? 'status.care_sheet_validated' : 'status.draft_to_review')|trans }}</twig:Status>
    </header>
    <a class="species-summary-name" href="{{ path('plant_show', {id: plant.id}) }}">
        <img class="species-summary-plate" src="{{ asset(plate.image) }}" alt="{{ plate.depicts ?? 'plate.schematic_alt'|trans }}" width="{{ plate.width }}" height="{{ plate.height }}" loading="lazy">
        <span>
            <strong>{{ plant.commonName }}</strong>
            <em class="latin">{{ plant.scientificName }}</em>
            <span class="kicker">{{ plant.family }}</span>
        </span>
    </a>
    <ul class="species-facts">
        <li><twig:Icon name="snowflake" :size="14"/> {{ (sheet.frostSensitive ? 'species.hardy_down_to_frost_sensitive' : 'species.hardy_down_to')|trans({temperature: sheet.minTemperatureC}) }}</li>
        <li><twig:Icon :name="sheet.exposure.value" :size="14"/> {{ sheet.exposure|trans }}</li>
        <li><twig:Icon name="drop" :size="14"/> {{ 'species.watering'|trans({watering: sheet.watering.value}) }}</li>
    </ul>
    <p class="species-reminders">
        {% if plant.validated %}
            <span class="kicker">{{ 'reminder.label'|trans }}</span>
            {% for type in plant.enabledReminderTypes %}<span class="tag tag-{{ type.value }}"><twig:Icon :name="type.pictogram" :size="13"/> {{ type|trans }}</span>{% else %}<span class="tag">{{ 'reminder.none_short'|trans }}</span>{% endfor %}
        {% else %}
            <span class="hint">{{ 'species.validate_for_reminders'|trans }}</span>
        {% endif %}
    </p>
    <twig:Button href="{{ path('plant_show', {id: plant.id}) }}" icon="note" class="button-next">{{ (plant.validated ? 'species.sheet_and_reminders' : 'species.review_and_validate')|trans }}</twig:Button>
</section>
