{% extends 'base.html.twig' %}

{% block title %}{{ 'space.add'|trans }} · Hop Garden{% endblock %}

{% block body %}
    <header class="plate-head">
        <nav class="breadcrumb"><a href="{{ path('spaces') }}">{{ 'nav.spaces'|trans }}</a> › {{ 'space.new'|trans }}</nav>
        <h1>{{ 'space.add'|trans }}</h1>
        <p>{{ 'space.new_intro'|trans }}</p>
    </header>

    {{ form_start(form, {attr: {class: 'card crowned care-sheet-form garden-form'}}) }}
        {{ form_errors(form) }}
        {{ include('space/_form.html.twig') }}

        <div class="actions">
            <twig:Button href="{{ path('spaces') }}" class="button-secondary">{{ 'action.cancel'|trans }}</twig:Button>
            <twig:Button icon="grid" :iconSize="18">{{ 'space.add_the_space'|trans }}</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
