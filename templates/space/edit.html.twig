{% extends 'base.html.twig' %}

{% block title %}{{ 'space.edit.title'|trans({name: space.name}) }} · Hop Garden{% endblock %}

{% block body %}
    <header class="plate-head">
        <nav class="breadcrumb"><a href="{{ path('spaces') }}">{{ 'nav.spaces'|trans }}</a> › <a href="{{ path('space_show', {id: space.id}) }}">{{ space.name }}</a> › {{ 'action.edit'|trans }}</nav>
        <h1>{{ 'space.edit.title'|trans({name: space.name}) }}</h1>
        <p>{{ 'space.edit.intro'|trans }}</p>
    </header>

    {{ form_start(form, {attr: {class: 'card crowned care-sheet-form garden-form'}}) }}
        {{ form_errors(form) }}
        {{ include('space/_form.html.twig') }}

        <div class="actions">
            <twig:Button href="{{ path('space_show', {id: space.id}) }}" class="button-secondary">{{ 'action.cancel'|trans }}</twig:Button>
            <twig:Button icon="check" :iconSize="18">{{ 'action.save'|trans }}</twig:Button>
        </div>
    {{ form_end(form) }}
{% endblock %}
