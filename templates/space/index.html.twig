{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.spaces'|trans }} · Hop Garden{% endblock %}

{% block body %}
<div class="with-specimen">
<div>
    <twig:PlateHead tab="IV" :title="'space.index.title'|trans" :subtitle="'space.index.subtitle'|trans"/>
    <p><twig:Button href="{{ path('space_new') }}" icon="grid" :iconSize="18" class="button-light button-next">{{ 'space.add'|trans }}</twig:Button></p>

    {% if spaces is empty %}
        <p class="callout">{{ 'space.index.empty'|trans({link: '<a href="' ~ path('space_new') ~ '">', link_end: '</a>'})|raw }}</p>
    {% else %}
        <ul class="plant-grid">
            {% for space in spaces %}
                <li><twig:SpaceTile :space="space"/></li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
<twig:Specimen plate="tecoma-ceramensis"/>
</div>
{% endblock %}
