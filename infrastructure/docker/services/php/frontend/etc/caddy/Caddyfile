{
    frankenphp
    auto_https off
    {$CADDY_GLOBAL_OPTIONS}

    log {
        output stdout
        format json
    }
}

# docker-compose.yml lists the addresses of the dev container, the production image serves every Host
# on :8080 (Dockerfile)
{$SERVER_NAME} {
    encode zstd gzip

    root /var/www/public
    php_server

    mercure {
        # Transport to use (default to Bolt)
        transport bolt {
            path /data/mercure.db
        }
        # Trusted issuer: access tokens must carry it in their iss claim
        issuer {$MERCURE_JWT_ISSUER} {
            # Publisher JWT key
            publisher {
                jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
            }
            # Subscriber JWT key
            subscriber {
                jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
            }
        }
        # The audience of the tokens: the public URL, whatever the proxy in front says of the scheme (Traefik ends the TLS)
        resource_identifier {$MERCURE_PUBLIC_URL}
        # Every update is private, and no subscriber is anonymous: the cookie of the application grants a member their
        # topics (src/Mercure/Topics.php). Keep its name in sync with config/packages/mercure.yaml
        cookie_name mercure_access_token
        # Extra directives
        {$MERCURE_EXTRA_DIRECTIVES}
    }
}
