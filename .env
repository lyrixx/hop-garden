# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
TRUSTED_PROXIES=127.0.0.1,172.17.0.0/16,172.18.0.0/15,172.20.0.0/14,172.24.0.0/13,192.168.0.0/16,10.0.0.0/8
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:app@postgres:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mercure-bundle ###
# Set by docker
###< symfony/mercure-bundle ###

###> symfony/routing ###
DEFAULT_URI=https://hop-garden.test
###< symfony/routing ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> hop-garden ###
# Demo mode, on by default: Trefle and Open-Meteo are replaced by the responses recorded in fixtures/http/,
# so only the LLM key is needed. Set APP_DEMO=0 (and TREFLE_TOKEN) in .env.local to use the real services.
APP_DEMO=1

# LLM provider used by the chat agent: "anthropic" or "openai". AI_MODEL must belong to that provider.
AI_PLATFORM=anthropic
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Free token from https://trefle.io
TREFLE_TOKEN=

# Garden location, used for the frost forecast (default: center of France)
GARDEN_LATITUDE=46.6
GARDEN_LONGITUDE=2.4
# Reminders are checked every day at 7:00 in this timezone
GARDEN_TIMEZONE=Europe/Paris

# URL the chat agent uses to reach this application's own MCP server
MCP_AGENT_URL=http://frontend/_mcp/agent
# Hosts the MCP server answers (DNS rebinding protection), comma-separated
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,frontend,hop-garden.test
###< hop-garden ###

###> symfony/mailer ###
MAILER_DSN=null://null
# The sender of the emails of the accounts (verification, approval, password reset)
MAILER_FROM="Hop Garden <hello@hop-garden.test>"
###< symfony/mailer ###
